<labwc_config>
  <!-- labwc theme -->
  <theme>
    <name>noctalia</name>
  </theme>
  <!-- Keyboard binds -->
  <keyboard>
    <!-- Include default labwc keybinds -->
    <default />
    <!-- Custom keys -->
    <keybind key="W-Return">
      <action name="Execute" command="wezterm" />
    </keybind>
    <keybind key="W-e">
      <action name="Execute" command="wezterm -e yazi" />
    </keybind>
    <keybind key="f10">
      <action name="Execute" command="wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle" />
    </keybind>
    <keybind key="C-S-backslash">
      <action name="Execute" command="~/Scripts/save-replay.sh" />
    </keybind>
    <keybind key="C-S-bracketleft">
      <action name="Execute" command="~/Scripts/start-replay.sh" />
    </keybind>
    <keybind key="C-S-bracketright">
      <action name="Execute" command="~/Scripts/stop-replay.sh" />
    </keybind>
    <keybind key="W-t">
      <action name="ToggleTearing" />
      <action name="Execute" command="~/Scripts/tearing-toggle.sh" />
    </keybind>
    <!-- Core keys -->
    <keybind key="Super_L" onRelease="yes">
      <action name="Execute">
        <command>noctalia msg panel-toggle launcher</command>
      </action>
    </keybind>
    <keybind key="W-s">
      <action name="Execute">
        <command>noctalia msg panel-toggle control-center</command>
      </action>
    </keybind>
    <keybind key="W-i">
      <action name="Execute">
        <command>noctalia msg settings-toggle</command>
      </action>
    </keybind>
    <!-- Media keys -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>noctalia msg volume-up</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>noctalia msg volume-down</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>noctalia msg volume-mute</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>noctalia msg brightness-up</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>noctalia msg brightness-down</command>
      </action>
    </keybind>
    <!-- Screenshots-->
    <keybind key="W-S-s">
      <action name="Execute" command="~/Scripts/screenshot.sh select" />
    </keybind>
    <keybind key="W-S-h">
      <action name="Execute" command="~/Scripts/ocr.sh horiz" />
    </keybind>
    <keybind key="W-S-v">
      <action name="Execute" command="~/Scripts/ocr.sh vert" />
    </keybind>
  </keyboard>
  <!-- End of keyboard binds -->
  <!-- Change mouse sensitivty -->
  <libinput>
    <device category="default">
      <pointerSpeed>-0,2</pointerSpeed>
      <accelProfile>flat</accelProfile>
    </device>
  </libinput>
  <core>
    <allowTearing>yes</allowTearing>
    <!--   <adaptiveSync>yes</adaptiveSync> -->
  </core>
  <!-- Thumbnail-based window switcher -->
  <windowSwitcher preview="no" outlines="yes">
    <osd style="thumbnail" output="cursor" />
  </windowSwitcher>
  <!-- End of window switcher -->
  <!-- Window snapping -->
  <snapping>
    <range>
      <outer>10</outer>
      <inner>10</inner>
    </range>
    <cornerRange>50</cornerRange>
    <overlay>
      <enabled>yes</enabled>
    </overlay>
    <topMaximize>yes</topMaximize>
  </snapping>
  <!-- End of Window snapping -->
  <!-- Window Focus setting -->
  <focus>
    <followMouse>yes</followMouse>
  </focus>
  <rules>
    <rule>
      <app-id>org.wezfurlong.wezterm</app-id>
      <blur>yes</blur>
      <opacity>0.8</opacity>
    </rule>
  </rules>
</labwc_config>
